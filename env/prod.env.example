# Environnement : freelanceflow-prod — copier ce fichier sans « .example » puis remplacer les « change-me »
COMPOSE_PROJECT_NAME=freelanceflow-prod
COMPOSE_PROFILES=
NODE_ENV=production

FRONT_PORT=80
MAILPIT_PORT=8025

POSTGRES_USER=freelanceFlow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=freelanceFlow

# openssl rand -hex 32
JWT_SECRET=change-me

# Compte administrateur créé au démarrage du backend
ADMIN_EMAIL=admin@freelanceflow.local
ADMIN_PASSWORD=change-me

# Vrai serveur SMTP (ex. Resend : utilisateur « resend », mot de passe = clé API) ; pas de Mailpit
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=change-me
MAIL_FROM=factures@votre-domaine.fr
