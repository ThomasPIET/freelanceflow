# Environnement : freelanceflow-test — copier ce fichier sans « .example » puis remplacer les « change-me »
COMPOSE_PROJECT_NAME=freelanceflow-test
COMPOSE_PROFILES=mail
NODE_ENV=test

FRONT_PORT=3101
MAILPIT_PORT=8125

POSTGRES_USER=freelanceFlow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=freelanceFlow

# openssl rand -hex 32
JWT_SECRET=change-me

# Compte administrateur créé au démarrage du backend
ADMIN_EMAIL=admin@freelanceflow.local
ADMIN_PASSWORD=change-me

# E-mails captés par Mailpit (http://localhost:8125)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM=factures@freelanceflow.local
