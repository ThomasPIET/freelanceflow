# Environnement : freelanceflow — copier ce fichier sans « .example » puis remplacer les « change-me »
COMPOSE_PROJECT_NAME=freelanceflow
COMPOSE_PROFILES=mail
NODE_ENV=development

FRONT_PORT=3001
MAILPIT_PORT=8025

POSTGRES_USER=freelanceFlow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=freelanceFlow

# openssl rand -hex 32
JWT_SECRET=change-me

# Compte administrateur créé au démarrage du backend
ADMIN_EMAIL=admin@freelanceflow.local
ADMIN_PASSWORD=change-me

# E-mails captés par Mailpit (http://localhost:8025)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM=factures@freelanceflow.local
